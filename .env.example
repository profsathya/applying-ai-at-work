# Canvas API credentials
# Get a personal access token from:
#   Canvas > Account > Settings > Approved Integrations > New Access Token

CANVAS_API_URL=https://deanza.instructure.com
CANVAS_API_TOKEN=your_token_here

# Course IDs - find these in the canvas URL when viewing each course
# (e.g., https://deanza.instructure.com/courses/12345 -> 12345)
COURSE1_CANVAS_ID=0
COURSE2_CANVAS_ID=0

# Optional: default course for ralph.sh when target is not specified.
# Valid values: course1 | course2
TARGET_COURSE=course1

# Optional: instance name for the manifest (defaults to "production")
CANVAS_INSTANCE_NAME=production
